{
  "manifest_version": 3,
  "name": "Netflix Auto Skip Intro",
  "version": "1.1.0",
  "description": "Automatically clicks Netflix's Skip Intro button when it appears.",
  "content_scripts": [
    {
      "matches": ["*://www.netflix.com/*", "*://netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "netflix-auto-skip@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
